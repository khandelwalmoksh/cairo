fn main(){
    let arr1: Array<u128> = array![];
    let (arr2, len) = calculate_length(arr1); //arr1 is moved
    println!("The length of array arr1 {:?} is {}", arr2, len);
}

fn calculate_length(arr: Array<u128) -> (Array<u128>, usize){
    let length = arr.len();
    (arr, length) //len() - returns the length of an array
}