#[derive(Drop)]
struct Rectangle {
    height: u64,
    width: u64,
}

fn main(){
    let mut rect 1 = Rectangle (height:3, width: 10);
    swap(ref rect1); //here, we're passing the reference of rect1 to the swap function, so rect1 is not moved, but we can still modify its fields through the reference.
    println!("height: {}, width: {}", rect1.height, rect1.width) 
}

fn swap(ref rect2: Rectangle) {
    let temp = rect2.height;
    rect2.height = rect2.width;
    rect2.width = temp;
    //println!("height: {}, width: {}", rect2.height, rect2.width)
}