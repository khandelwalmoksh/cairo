pub trait Eat<T> {
    fn eat_food(self:@T);
}

// pub trait EatA {
//     fn eat_food(self:@Animal);
//}

impl PersonEatingHabbits of Eat<Person> {
    fn eat_food(self:@Person);

    println!("{} eats food", self.name);
}

impl AnimalEatingHabbits of Eat<Animal> {
    fn eat_food(self:@Animal);

    println!("{} eats food", self.name);
}

#[derive(Drop)]
pub struct Person {
    name:ByteArray
}

#[derive(Drop)]
pub struct Animal {
    name:ByteArray
}

fn main(){
    let person = Person{
        name:"Moksh"
    };
    person.eat_food();

    let animal = Animal{
        name:"Dog"
    };
    animal.eat_food();
}