#[derive(Drop, Debug)]
struct A {
    roll_number: u32;
}

fn main(){
    let ai = gives_ownership(); // A {roll_number: 123};
    let a2 = A {roll_number: 101};  // invalid
    let a3 = A takes_and_gives_back(a2); //A {roll_number: 101};  value of a2 is moved to a3
    println!("A: {:?}", a1);
    println!("A: {:?}", a2);
    println!("A: {:?}", a3);
}

fn gives_ownership() -> A{
    let some_a = A {roll_number: 123};
}

fn takes_and_gives_back(some_a: A) -> A {
    some_a
}